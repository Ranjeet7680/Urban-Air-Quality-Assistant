# ==========================================
# URBAN AIR QUALITY ASSISTANT — ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="Urban Air Quality Assistant"
API_V1_STR=/api

# Security & Session Authentication
SECRET_KEY=super-secret-jwt-encryption-key-for-urban-air-saas-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Persistence
# Default is SQLite for instant zero-dependency execution.
# For production PostgreSQL: postgresql://postgres:password@localhost:5432/urban_air_db
DATABASE_URL=sqlite:///./urban_air_quality.db

# Google Gemini API
# If empty, the built-in scientific atmospheric reasoning engine provides grounded analysis.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Server Ports
BACKEND_PORT=8005
FRONTEND_PORT=5174

# Data Ingestion Intervals (seconds)
TELEMETRY_REFRESH_INTERVAL=600
ALERT_POLL_INTERVAL=30
